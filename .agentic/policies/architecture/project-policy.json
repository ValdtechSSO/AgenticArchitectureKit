{
  "$schema": "https://raw.githubusercontent.com/ValdtechSSO/AgenticArchitectureKit/v0.4.0/src/agentic_architecture_kit/data/schemas/architecture-policy.schema.json",
  "version": 1,
  "project": "AgenticArchitectureKit",
  "adapter": "python",
  "adapterConfig": {
    "packageRoots": ["src", "tools", "tests"]
  },
  "roots": {
    "modules": "src",
    "hosts": "tools"
  },
  "projectSearchRoots": ["pyproject.toml", "src", "tools", "tests"],
  "structureSearchRoots": ["src", "tools", "tests", ".agentic"],
  "moduleContract": {
    "fileName": "module.contract.yml",
    "schema": "package:module-contract.schema.json",
    "forbiddenStructuralFields": ["projects", "dependencies", "files", "namespaces"]
  },
  "technicalModuleNames": ["git", "providers", "validation", "infrastructure", "persistence", "shared", "common", "utils"],
  "forbiddenDirectoryNames": ["Helpers", "Utils", "Common", "Misc", "General"],
  "modules": [
    {
      "id": "agentic_architecture_kit",
      "root": "src/agentic_architecture_kit",
      "namespacePatterns": ["agentic_architecture_kit", "agentic_architecture_kit.*"],
      "decisionRefs": ["architecture/decisions/ADR-001-portable-validator-boundary.md"]
    }
  ],
  "hosts": [
    {
      "id": "aak-cli",
      "root": "tools/aak.py",
      "allowedSourcePatterns": ["aak.py"],
      "namespacePatterns": ["aak"],
      "decisionRefs": ["architecture/decisions/ADR-001-portable-validator-boundary.md"]
    }
  ],
  "projects": [
    {
      "path": "pyproject.toml",
      "name": "agentic-architecture-kit",
      "owner": { "kind": "module", "id": "agentic_architecture_kit" },
      "role": "application",
      "decisionRefs": ["architecture/decisions/ADR-001-portable-validator-boundary.md"]
    }
  ],
  "allowedProjectDependencies": [],
  "dependencyRules": [
    {
      "from": { "ownerKind": "host" },
      "to": { "ownerKind": "module" },
      "decisionRefs": ["architecture/decisions/ADR-001-portable-validator-boundary.md"]
    }
  ]
}
