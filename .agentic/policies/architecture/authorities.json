{
  "$schema": "../../contracts/schemas/architecture-authorities.schema.json",
  "version": 1,
  "enforcement": {
    "provider": "github",
    "codeOwnersFile": ".github/CODEOWNERS",
    "protectedBranches": ["main"],
    "requirements": [
      "pull-request",
      "code-owner-review",
      "dismiss-stale-reviews",
      "no-direct-push",
      "required-status-checks"
    ]
  },
  "authorities": [
    {
      "id": "kit-maintainers",
      "displayName": "Agentic Architecture Kit maintainers",
      "principals": ["@valdtechsecurity"],
      "protectedScopes": ["."]
    }
  ]
}
