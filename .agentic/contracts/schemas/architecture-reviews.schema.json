{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviews"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1] },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "scope", "subjectFingerprint", "decision", "authorityId", "reviewedBy", "approvalEvidence", "authorizedBy", "reviewedAtRevision", "reviewWhen"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "subjectFingerprint": { "type": "string", "minLength": 64 },
          "decision": { "type": "string", "minLength": 1 },
          "authorityId": { "type": "string", "minLength": 1 },
          "reviewedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "approvalEvidence": { "type": "string", "minLength": 1 },
          "authorizedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reviewedAtRevision": { "type": "string", "minLength": 1 },
          "expiresOn": { "type": "string", "minLength": 1 },
          "reviewWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
