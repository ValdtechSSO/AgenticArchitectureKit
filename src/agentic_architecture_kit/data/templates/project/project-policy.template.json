{
  "$schema": "https://raw.githubusercontent.com/ValdtechSSO/AgenticArchitectureKit/v0.4.6/src/agentic_architecture_kit/data/schemas/architecture-policy.schema.json",
  "version": 1,
  "project": "replace-with-project-id",
  "adapter": "dotnet",
  "adapterConfig": {},
  "roots": {
    "modules": "src/Modules",
    "hosts": "src/Hosts"
  },
  "projectSearchRoots": [
    "src"
  ],
  "structureSearchRoots": [
    "src"
  ],
  "moduleContract": {
    "fileName": "module.contract.yml",
    "schema": "package:module-contract.schema.json",
    "forbiddenStructuralFields": [
      "paths",
      "entrypoints",
      "handlers",
      "classes",
      "tests",
      "entities_read",
      "entities_written",
      "routes"
    ]
  },
  "technicalModuleNames": [
    "Git",
    "Providers",
    "Repositories",
    "Validation",
    "Services",
    "Infrastructure"
  ],
  "forbiddenDirectoryNames": [
    "Services",
    "Managers",
    "Helpers",
    "Utils",
    "Common"
  ],
  "modules": [
    {
      "id": "samplecapability",
      "root": "src/Modules/SampleCapability",
      "featureRoot": "src/Modules/SampleCapability/Features",
      "featureAreas": [
        "SampleLifecycle"
      ],
      "namespacePatterns": ["SampleCapability", "SampleCapability.*"],
      "contractNamespacePatterns": ["SampleCapability.Contracts", "SampleCapability.Contracts.*"],
      "decisionRefs": ["architecture/decisions/ADR-001-initial-architecture.md"]
    }
  ],
  "hosts": [
    {
      "id": "sample-host",
      "root": "src/Hosts/SampleHost",
      "allowedSourcePatterns": [
        "Program.cs"
      ],
      "namespacePatterns": ["SampleHost", "SampleHost.*"],
      "decisionRefs": ["architecture/decisions/ADR-001-initial-architecture.md"]
    }
  ],
  "projects": [
    {
      "path": "src/Modules/SampleCapability/SampleCapability.csproj",
      "name": "SampleCapability",
      "owner": {
        "kind": "module",
        "id": "samplecapability"
      },
      "role": "application",
      "decisionRefs": ["architecture/decisions/ADR-001-initial-architecture.md"]
    },
    {
      "path": "src/Hosts/SampleHost/SampleHost.csproj",
      "name": "SampleHost",
      "owner": {
        "kind": "host",
        "id": "sample-host"
      },
      "role": "host",
      "decisionRefs": ["architecture/decisions/ADR-001-initial-architecture.md"]
    }
  ],
  "allowedProjectDependencies": [
    {
      "from": "src/Hosts/SampleHost/SampleHost.csproj",
      "to": "src/Modules/SampleCapability/SampleCapability.csproj",
      "decisionRefs": ["architecture/decisions/ADR-001-initial-architecture.md"]
    }
  ],
  "dependencyRules": []
}
