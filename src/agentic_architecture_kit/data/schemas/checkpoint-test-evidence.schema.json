{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "startedAt", "completedAt", "command", "exitCode", "outcome", "beforeWorkspace", "afterWorkspace", "stdout", "stderr", "evidenceDigest"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1] },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "exitCode": { "type": "integer" },
    "outcome": { "type": "string", "enum": ["passed", "failed", "error"] },
    "beforeWorkspace": { "$ref": "#/$defs/workspace" },
    "afterWorkspace": { "$ref": "#/$defs/workspace" },
    "stdout": { "$ref": "#/$defs/output" },
    "stderr": { "$ref": "#/$defs/output" },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRevision", "dirty", "fingerprint", "fileCount", "changedPaths"],
      "properties": {
        "repositoryRevision": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "fileCount": { "type": "integer" },
        "changedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bytes": { "type": "integer" }
      }
    }
  }
}
