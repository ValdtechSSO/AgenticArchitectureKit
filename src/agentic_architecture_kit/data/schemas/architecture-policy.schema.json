{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "adapter",
    "roots",
    "projectSearchRoots",
    "structureSearchRoots",
    "moduleContract",
    "technicalModuleNames",
    "forbiddenDirectoryNames",
    "modules",
    "hosts",
    "projects",
    "allowedProjectDependencies"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1] },
    "project": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "adapterConfig": { "type": "object" },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "hosts"],
      "properties": {
        "modules": { "type": "string", "minLength": 1 },
        "hosts": { "type": "string", "minLength": 1 }
      }
    },
    "projectSearchRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "structureSearchRoots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "moduleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "schema", "forbiddenStructuralFields"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "forbiddenStructuralFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "technicalModuleNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenDirectoryNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "featureRoot": { "type": "string", "minLength": 1 },
          "featureAreas": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "namespacePatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "contractNamespacePatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "decisionRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "allowedSourcePatterns"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "allowedSourcePatterns": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "namespacePatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "decisionRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "name", "owner", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string", "enum": ["module", "host"] },
              "id": { "type": "string", "minLength": 1 }
            }
          },
          "role": {
            "type": "string",
            "enum": ["application", "infrastructure", "contracts", "host"]
          },
          "publicContract": { "type": "boolean" },
          "decisionRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "allowedProjectDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "decisionRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "dependencyRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "decisionRefs"],
        "properties": {
          "from": { "$ref": "#/$defs/projectSelector" },
          "to": { "$ref": "#/$defs/projectSelector" },
          "decisionRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "projectSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerKind": { "type": "string", "enum": ["module", "host"] },
        "ownerId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["application", "infrastructure", "contracts", "host"] },
        "pathPattern": { "type": "string", "minLength": 1 }
      }
    }
  }
}
