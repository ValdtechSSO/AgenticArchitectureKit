{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "purpose", "intent", "ownership", "risk", "invariants", "architecture_decisions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "intent": { "type": "object", "additionalProperties": false, "required": ["aliases"], "properties": { "aliases": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "ownership": { "type": "object", "additionalProperties": false, "required": ["domain", "authoritative_data"], "properties": { "domain": { "type": "string" }, "authoritative_data": { "type": "array", "items": { "type": "string" } } } },
    "risk": { "type": "object", "additionalProperties": false, "required": ["default", "reasons"], "properties": { "default": { "enum": ["low", "medium", "high", "critical"] }, "reasons": { "type": "array", "items": { "type": "string" } } } },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "architecture_decisions": { "type": "array", "items": { "type": "string" } }
  }
}

