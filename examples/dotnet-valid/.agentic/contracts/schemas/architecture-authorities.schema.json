{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enforcement", "authorities"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1] },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "codeOwnersFile", "protectedBranches", "requirements"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "codeOwnersFile": { "type": "string", "minLength": 1 },
        "protectedBranches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["pull-request", "code-owner-review", "dismiss-stale-reviews", "no-direct-push", "required-status-checks"]
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "principals", "protectedScopes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "principals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "protectedScopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
