{
  "version": 1,
  "enforcement": {
    "provider": "github",
    "codeOwnersFile": ".github/CODEOWNERS",
    "protectedBranches": ["main"],
    "requirements": ["pull-request", "code-owner-review", "dismiss-stale-reviews", "no-direct-push", "required-status-checks"]
  },
  "authorities": [{
    "id": "example-maintainers",
    "displayName": "Example maintainers",
    "principals": ["@example-maintainer"],
    "protectedScopes": ["."]
  }]
}
